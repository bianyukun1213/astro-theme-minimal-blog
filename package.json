{
	"name": "astro-theme-minimal-blog",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build:astro": "astro build",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations && bun run build:astro",
		"build:search": "bun ./scripts/buildSearchIndex.ts",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"assistant": "tsx ./scripts/assistant.ts",
		"machine-translate": "inlang machine translate --project project.inlang",
		"compile-messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
		"test:search": "bun test ./tests/buildSearchIndex.ts",
		"generate-types": "wrangler types"
	},
	"dependencies": {
		"@astrojs/alpinejs": "^1.0.0",
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.3.3",
		"@astrojs/markdown-satteri": "^0.4.2",
		"@astrojs/mdx": "^8.0.2",
		"@astrojs/react": "^7.0.0",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/alpinejs": "^3.17.0",
		"alpinejs": "^3.17.4",
		"astro": "^7.3.5",
		"astro-expressive-code": "^0.44.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"github-slugger": "^2.0.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"satteri": "^0.10.5",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.143.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@clack/prompts": "^1.8.1",
		"@inlang/cli": "^3.3.8",
		"@inlang/paraglide-js": "^2.25.4",
		"@tailwindcss/typography": "^0.5.20",
		"@types/bun": "^1.4.2",
		"@types/mdast": "^4.0.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@waline/client": "^3.16.0",
		"astro-eslint-parser": "^3.2.0",
		"daisyui": "^5.7.46",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-format": "^2.0.1",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"sharp": "^0.35.5",
		"sirv": "^3.0.2",
		"tailwind-resolver": "^0.3.8",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"valid-filename": "^5.0.0"
	}
}
