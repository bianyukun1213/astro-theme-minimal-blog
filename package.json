		"daisyui": "^5.5.23",
		"eslint": "^10.5.0",
		"eslint-plugin-astro": "^2.0.0",
		"eslint-plugin-format": "^2.0.1",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
