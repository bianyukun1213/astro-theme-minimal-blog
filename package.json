{
	"name": "astro-theme-minimal-blog",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build:pagefind": "pagefind",
		"build:astro": "astro build",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide --emit-ts-declarations && bun run build:astro && bun run build:pagefind",
