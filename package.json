{
	"name": "astro-theme-minimal-blog",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build:astro": "astro build",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide --emit-ts-declarations && bun run build:astro",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"assistant": "tsx ./scripts/assistant.ts",
		"machine-translate": "inlang machine translate --project project.inlang",
		"compile-messages": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide --emit-ts-declarations",
		"generate-types": "wrangler types"
	},
	"dependencies": {
		"@astrojs/alpinejs": "^1.0.0",
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.2.0",
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/react": "^6.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@expressive-code/plugin-collapsible-sections": "^0.44.1",
		"@expressive-code/plugin-line-numbers": "^0.44.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/alpinejs": "^3.13.11",
		"alpinejs": "^3.15.12",
		"astro": "^7.2.0",
		"astro-expressive-code": "^0.44.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"photoswipe": "^5.4.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-cjk-friendly": "^2.3.1",
		"remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
		"remark-collapse": "^0.1.2",
		"remark-rehype-wrap": "^0.0.5",
		"remark-toc": "^9.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.120.0"
