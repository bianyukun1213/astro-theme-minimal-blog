		"daisyui": "^5.7.16",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-format": "^2.0.1",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"mdast-util-mdx-jsx": "^3.2.0",
