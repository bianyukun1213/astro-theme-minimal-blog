---
import { defaultDateFormat, getLocalizedTagName, removeTrailingSlash, useTranslations, type Locale } from '@utils'
import Picture from 'astro/components/Picture.astro'
import { trailingSlash } from 'astro:config/client'
import type { CollectionEntry } from 'astro:content'
import Pin from './icons/pin.svg'
import Link from './link.astro'
import Spacer from './spacer.astro'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	post: CollectionEntry<'blog'>
	showSticky?: boolean
}

const { post, showSticky = false } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

const title = post.data.title || m.site_title()
---

<div>
	<Link variant="highlight" href={`${removeTrailingSlash(base)}/${currentLocale}/posts/${post.data.displayId}${slash}`}>
		{
			post.data.image && (
				<>
					<figure class="relative">
						<img class="block w-full aspect-3/1 object-cover" src={post.data.image} alt={post.data.imageAlt} />
					</figure>
					<Spacer axis="vertical" size={2} />
				</>
			)
		}
		{
			showSticky && post.data.sticky > 0 && <Pin class="inline-block align-middle me-2" aria-label={m.label_sticky()} />
		}<span class="align-middle">{`${post.data.draft ? '[' + m.label_draft() + '] ' : ''}${title}`}</span>
	</Link>
	<Spacer axis="vertical" size={2} />
	<div class="text-faded">
		{defaultDateFormat(post.data.date, currentLocale)} — {
			post.data.tags.map((tagSlug) => getLocalizedTagName(tagSlug, currentLocale)).join(', ')
		}
	</div>
	<Spacer axis="vertical" size={2} />
	<div class="text-faded text-md md:text-lg">{post.data.description}</div>
</div>
