---
interface Props {
	title: string
}

const { title } = Astro.props
---

<details class="collapse collapse-arrow border border-border my-6">
	<summary class="collapse-title font-medium after:inset-s-5 after:inset-e-auto pe-4 ps-12">{title}</summary>
	<div class="collapse-content">
		<slot />
	</div>
</details>
