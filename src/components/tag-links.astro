---
import type { TagSlug } from '@constants'
import { getLocalizedTagName, removeTrailingSlash, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'
import Link from './link.astro'

const currentLocale = Astro.currentLocale as Locale

interface Props {
	tags: TagSlug[]
}

const { tags } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'
---

{
	tags.map((tagSlug, i) => (
		<>
			<Link
				class="font-normal no-underline hover:underline!"
				data-pagefind-filter="tag"
				href={`${removeTrailingSlash(base)}/${currentLocale}/tags/${tagSlug}${slash}`}
			>
				{getLocalizedTagName(tagSlug, currentLocale)}
			</Link>
			{i < tags.length - 1 && ', '}
		</>
	))
}
