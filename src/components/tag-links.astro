---
import { FRONTMATTER_TAGS, type FrontmatterTag } from '@constants'
import { appendTrailingSlash } from '@utils'
import Link from './link.astro'

interface Props {
	tags: FrontmatterTag[]
}

const { tags } = Astro.props

const base = import.meta.env.BASE_URL
---

{
	tags.map((tag, i) => (
		<>
			<Link
				class="font-normal no-underline hover:underline!"
				data-pagefind-filter="tag"
				href={`${appendTrailingSlash(base)}tags/${FRONTMATTER_TAGS.get(tag)}/`}
			>
				{tag}
			</Link>
			{i < tags.length - 1 && ', '}
		</>
	))
}
