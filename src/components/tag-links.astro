---
import { FRONTMATTER_TAGS, type FrontmatterTag } from '@constants'
import { removeTrailingSlash } from '@utils'
import { trailingSlash } from 'astro:config/client'
import Link from './link.astro'

interface Props {
	tags: FrontmatterTag[]
}

const { tags } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'
---

{
	tags.map((tag, i) => (
		<>
			<Link
				class="font-normal no-underline hover:underline!"
				data-pagefind-filter="tag"
				href={`${removeTrailingSlash(base)}/tags/${FRONTMATTER_TAGS.get(tag)}${slash}`}
			>
				{tag}
			</Link>
			{i < tags.length - 1 && ', '}
		</>
	))
}
