---
import type { Locale } from '@utils'
import Link from './link.astro'
import Spacer from './spacer.astro'

const currentLocale = Astro.currentLocale as Locale
---

{
	currentLocale === 'en-US' ? (
		<>
			<h2 class="mb-0! text-highlight">Welcome! 👋</h2>
			<Spacer axis="vertical" size={12} />
			<p>
				This is the personal blog of{' '}
				<Link href="https://yukun.bio/" target="_blank" rel="noopener">
					Bian Yukun
				</Link>
				.
			</p>
			<p>
				Thank you for visiting! If you want to check the latest content, please go to the{' '}
				<Link href="/zh-CN/">Chinese site</Link>. I could spend months doing other things before actually translating a
				post.
			</p>
		</>
	) : currentLocale === 'zh-CN' ? (
		<>
			<h2 class="mb-0! text-highlight">欢迎！👋</h2>
			<Spacer axis="vertical" size={12} />
			<p>
				这是
				<Link href="https://yukun.bio/" target="_blank" rel="noopener">
					边宇琨
				</Link>
				的个人博客。
			</p>
		</>
	) : currentLocale === 'ru-RU' ? (
		<>
			<h2 class="mb-0! text-highlight">Привет! 👋</h2>
			<Spacer axis="vertical" size={12} />
			<p>
				Это личный блог{' '}
				<Link href="https://yukun.bio/" target="_blank" rel="noopener">
					Бянь Юйкунь
				</Link>
				.
			</p>
			<p>
				Спасибо за посещение! Если вы хотите ознакомиться с последними материалами, пожалуйста, перейдите на{' '}
				<Link href="/zh-CN/">китайский сайт</Link>. Я могу потратить месяцы на другие дела, прежде чем действительно
				перевести пост.
			</p>
		</>
	) : currentLocale === 'he-IL' ? (
		<>
			<h2 class="mb-0! text-highlight">שלום! 👋</h2>
			<Spacer axis="vertical" size={12} />
			<p>
				זהו הבלוג האישי של{' '}
				<Link href="https://yukun.bio/" target="_blank" rel="noopener">
					ביאן יוקון
				</Link>
				.
			</p>
			<p>
				תודה שביקרת! אם אתה רוצה לבדוק את התוכן האחרון, אנא עבור אל <Link href="/zh-CN/">האתר הסיני</Link>. אני יכול
				לבלות חודשים בדברים אחרים לפני שאתרגם בפועל פוסט.
			</p>
		</>
	) : (
		<>
			<h2 class="mb-0! text-highlight">PLACEHOLDER</h2>
			<Spacer axis="vertical" size={12} />
			<p>PLACEHOLDER</p>
		</>
	)
}
