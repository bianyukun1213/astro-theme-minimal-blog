---
import { removeTrailingSlash } from '@utils'

const base = import.meta.env.BASE_URL
---

<div id="tide-interactions-webmentionjs"></div>
<style is:global>
	#tide-interactions-webmentionjs {
		position: relative;
		margin: 0;
		padding: 0;
	}

	#tide-interactions-webmentionjs h2 {
		margin: 0;
		margin-bottom: 1rem;
		/* xl */
		font-size: var(--text-xl);
		line-height: var(--tw-leading, var(--text-xl--line-height));
		font-weight: var(--font-weight-medium);
	}

	#tide-interactions-webmentionjs ul {
		padding: 0;
		margin: 0;
		list-style-type: none;
	}

	#tide-interactions-webmentionjs .reaction {
		display: block;
		float: inline-start;
		text-decoration: none;
	}

	#tide-interactions-webmentionjs .reaction img {
		max-width: none;
		display: inline-block;
		vertical-align: baseline;
		width: 2.5rem;
		height: 2.5rem;
		object-fit: contain;
		margin-inline-end: -1rem;
		border-radius: 0.375rem;
	}

	#tide-interactions-webmentionjs .source {
		display: block;
		float: inline-start;
		font-weight: var(--font-weight-medium);
		/* color: var(--color-faded); */
		text-decoration-color: transparent;
	}

	#tide-interactions-webmentionjs .source:hover {
		text-decoration-color: currentColor;
		text-decoration-line: underline;
		text-underline-offset: 4px;
	}

	#tide-interactions-webmentionjs .comments li {
		margin-bottom: 4rem;
	}

	#tide-interactions-webmentionjs .comments li::after {
		content: '';
		height: 0;
		clear: both;
		overflow: hidden;
		display: block;
		visibility: hidden;
	}

	#tide-interactions-webmentionjs .comments li .reaction {
		margin-inline-end: 0.5rem;
		margin-bottom: 1rem;
	}

	#tide-interactions-webmentionjs .comments li .text {
		display: block;
		width: 100%;
		clear: both;
	}

	/* #tide-interactions-webmentionjs .comments li .text::before {
    content: '“';
    color: var(--tide-color-text-secondary);
} */

	/* #tide-interactions-webmentionjs .comments li .text::after {
    content: '”';
    color: var(--tide-color-text-secondary);
} */

	#tide-interactions-webmentionjs .comments li .name {
		display: block;
		width: 100%;
		clear: both;
		/* font-style: italic; */
		font-weight: var(--font-weight-medium);
		color: var(--color-faded);
	}

	#tide-interactions-webmentionjs .reacts::after {
		content: '';
		height: 0;
		clear: both;
		overflow: hidden;
		display: block;
		visibility: hidden;
	}

	#tide-interactions-webmentionjs .reacts .reaction {
		margin-inline-end: 0.5rem;
		margin-bottom: 0.5rem;
	}
</style>
<script
	is:inline
	src=`${removeTrailingSlash(base)}/scripts/webmention.js`
	data-id="tide-interactions-webmentionjs"
	data-page-url="https://his2nd.life/zh-CN/posts/127efb3.html"></script>
<script>
	window.tideInteractions = window.tideInteractions ?? {}
	window.tideInteractions.webmentionjs = {
		load() {},
		unload() {},
	}
</script>
