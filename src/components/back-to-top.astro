---
import { useTranslations, type Locale } from '@utils'
import ArrowUpToLine from './icons/arrow-up-to-line.svg'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)
---

<button
	id="back-to-top"
	transition:persist
	title={m.btn_back_to_top_title()}
	aria-label={m.btn_back_to_top_title()}
	class="atmb-button fixed bottom-4 inset-e-4 size-10 z-10 ltr:translate-x-14 rtl:-translate-x-14"
	disabled
>
	<ArrowUpToLine aria-hidden="true" />
</button>

<script>
	function initBackToTop() {
		const btn = document.getElementById('back-to-top')
		if (!btn) {
			return
		}
		const onScroll = () => {
			const visible = window.scrollY > 1200
			btn.classList.toggle('ltr:translate-x-14', !visible)
			btn.classList.toggle('rtl:-translate-x-14', !visible)
			if (visible) {
				btn.removeAttribute('disabled')
			} else {
				btn.setAttribute('disabled', '')
			}
		}
		window.addEventListener('scroll', onScroll, { passive: true })
		onScroll()
		btn.addEventListener('click', () => {
			window.scrollTo({ top: 0 })
		})
	}

	document.addEventListener('astro:page-load', initBackToTop)
</script>
