---
import { SITE, getKeywords } from '@constants'
import { removeTrailingSlash, useTranslations, type Locale } from '@utils'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	title?: string
	titleOverride?: string
	keywords?: string[]
	description?: string
	image?: string
	noIndex?: boolean
}

const { title, titleOverride, keywords, description, image, noIndex = false } = Astro.props

const base = import.meta.env.BASE_URL

const siteTitle = m.site_title()
const siteKeywords = getKeywords(currentLocale)
const siteDescription = m.site_description()
const siteImage = m.site_default_og_image()
const { url: siteUrl } = SITE

const validImage = image || siteImage
const seo = {
	title: title ? `${title} | ${siteTitle}` : siteTitle,
	keywords: keywords ? keywords.join(', ') : siteKeywords.join(', '),
	description: description || siteDescription,
	url: Astro.url,
	image:
		validImage.startsWith('http://') || validImage.startsWith('https://')
			? validImage
			: new URL(`${removeTrailingSlash(base)}${validImage}`, siteUrl),
}

if (titleOverride) {
	seo.title = titleOverride
}
---

<title>{seo.title}</title>
<meta name="keywords" content={seo.keywords} />
<meta name="description" content={seo.description} />
<meta name="image" content={seo.image} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteTitle}
	href={new URL(`${removeTrailingSlash(base)}/${currentLocale}/rss.xml`, Astro.site)}
/>
<link rel="canonical" href={seo.url} />
<meta property="og:title" content={seo.title} />
<meta property="og:url" content={seo.url} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={seo.image} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:url" content={seo.url} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}
<slot />
