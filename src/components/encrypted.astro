---
interface Props {
	password: string
	hint?: string
}

const { password, hint } = Astro.props
const encoder = new TextEncoder()

const hashBuffer = await crypto.subtle.digest('SHA-256', encoder.encode(password))
const passwordHash = Array.from(new Uint8Array(hashBuffer))
	.map((b) => b.toString(16).padStart(2, '0'))
	.join('')

const cookieKey = `enc_${passwordHash.slice(0, 16)}`

const secret = import.meta.env.ENCRYPT_SECRET ?? 'dev-secret-change-in-prod'
const key = await crypto.subtle.importKey('raw', encoder.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, [
	'sign',
])
const signBuffer = await crypto.subtle.sign('HMAC', key, encoder.encode(passwordHash))
const expectedSig = Array.from(new Uint8Array(signBuffer))
	.map((b) => b.toString(16).padStart(2, '0'))
	.join('')

const isUnlocked = Astro.cookies.get(cookieKey)?.value === expectedSig
const hasError = Astro.url.searchParams.has(`enc_error_${cookieKey}`)
const base = import.meta.env.BASE_URL
---

{
	isUnlocked ? (
		<slot />
	) : (
		<div class="not-prose my-6 rounded-lg border border-dashed p-6 text-center">
			<p class="text-faded mb-4">🔒 此内容已加密</p>
			{hint && <p class="text-faded mb-4 text-sm">{hint}</p>}
			{hasError && <p class="mb-3 text-sm text-red-500">密码错误，请重试</p>}
			<form method="POST" action={`${base}api/unlock/`} class="flex flex-col items-center gap-4">
				<input type="hidden" name="hash" value={passwordHash} />
				<input type="hidden" name="cookieKey" value={cookieKey} />
				<input type="hidden" name="redirectTo" value={Astro.url.toString()} />
				<input
					type="password"
					name="password"
					placeholder="请输入密码"
					required
					class="rounded border px-3 py-1.5 text-sm"
				/>
				<button type="submit" class="rounded px-4 py-1.5 text-sm font-medium">
					{' '}
					解锁{' '}
				</button>
			</form>
		</div>
	)
}
