---
import { cn, removeTrailingSlash, useTranslations, type Locale } from '@utils'
import Spacer from './spacer.astro'
import { trailingSlash } from 'astro:config/client'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	password: string
	hint?: string
	hidden?: boolean
}

const { password, hint, hidden = false } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

const encoder = new TextEncoder()
const hashBuffer = await crypto.subtle.digest('SHA-256', encoder.encode(password))
const passwordHash = Array.from(new Uint8Array(hashBuffer))
	.map((b) => b.toString(16).padStart(2, '0'))
	.join('')

const cookieKey = `protection_${passwordHash.slice(0, 16)}`

const secret = import.meta.env.PROTECTION_SECRET ?? 'dev-secret-change-in-prod'
const key = await crypto.subtle.importKey('raw', encoder.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, [
	'sign',
])
const signBuffer = await crypto.subtle.sign('HMAC', key, encoder.encode(passwordHash))
const expectedSig = Array.from(new Uint8Array(signBuffer))
	.map((b) => b.toString(16).padStart(2, '0'))
	.join('')

const isUnlocked = Astro.cookies.get(cookieKey)?.value === expectedSig
const hasError = Astro.url.searchParams.has(`protection_error_${cookieKey}`)
---

{
	isUnlocked ? (
		<div class="unlocked relative rounded-sm border border-border">
			<div class="absolute z-10 inset-e-2 top-0 -mt-4">
				<form method="POST" action={`${removeTrailingSlash(base)}/api/lock${slash}`}>
					<input type="hidden" name="cookieKey" value={cookieKey} />
					<input type="hidden" name="redirectTo" value={Astro.url.toString()} />
					<button type="submit" class="atmb-button text-sm">
						{m.btn_lock_title()}
					</button>
				</form>
			</div>
			<slot />
		</div>
	) : (
		<div class={cn('protected not-prose my-6 p-4 rounded-sm border border-border text-center', hidden && 'hidden')}>
			<p>{m.label_locked()}</p>
			<Spacer axis="vertical" size={4} />
			{hint && (
				<>
					<p class="text-faded text-sm">{hint}</p>
					<Spacer axis="vertical" size={4} />
				</>
			)}
			{hasError && (
				<>
					<p class="text-sm text-red-500">{m.label_password_incorrect()}</p>
					<Spacer axis="vertical" size={4} />
				</>
			)}
			<form method="POST" action={`${removeTrailingSlash(base)}/api/unlock${slash}`} class="flex flex-col items-center">
				<input type="hidden" name="hash" value={passwordHash} />
				<input type="hidden" name="cookieKey" value={cookieKey} />
				<input type="hidden" name="redirectTo" value={Astro.url.toString()} />
				<input
					type="password"
					class="atmb-input text-sm"
					name="password"
					placeholder={m.label_password_placeholder()}
					required
				/>
				<Spacer axis="vertical" size={4} />
				<button type="submit" class="atmb-button text-sm">
					{m.btn_unlock_title()}
				</button>
			</form>
		</div>
	)
}
