---
import { getHeader } from '@constants'
import { removeTrailingSlash, useTranslations, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'
import Link from './link.astro'
import Search from './search.astro'
import Spacer from './spacer.astro'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

const { pathname } = Astro.url
const header = getHeader(currentLocale)
---

<header class="container">
	<Spacer axis="vertical" size={8} />
	<div class="flex flex-row justify-between items-center">
		<div>
			<a
				class="font-semibold text-xl md:text-2xl lg:text-3xl text-highlight"
				href={`${removeTrailingSlash(base)}/${currentLocale}${slash}`}
				aria-label={m.label_back_to_home({ siteTitle: m.site_title() })}>{m.site_title()}</a
			>
		</div>
		<Search />
	</div>
	<Spacer axis="vertical" size={4} />
	<div class="flex flex-row justify-between items-center border-b border-border pb-4 text-lg md:text-xl">
		<nav aria-label={m.label_primary_navigation()} class="flex gap-4">
			{
				header.internal.map((link) => (
					<Link
						href={link.url}
						class={pathname === link.url ? 'active' : ''}
						aria-current={pathname === link.url ? 'page' : 'false'}
					>
						{link.title}
					</Link>
				))
			}
		</nav>
		<div class="flex gap-4">
			{
				header.external.map((link) => (
					<Link href={link.url} {...link.props}>
						{link.title}
					</Link>
				))
			}
		</div>
	</div>
	<Spacer axis="vertical" size={12} />
</header>
