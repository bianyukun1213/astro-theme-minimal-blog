<div id="tide-interactions-waline"></div>
<script>
	import { SITE } from '@constants'
	import { init } from '@waline/client'
	import '@waline/client/style'

	window.tideInteractions = window.tideInteractions ?? {}
	window.tideInteractions.waline = {
		load(update = false) {
			if (update) {
				this.instance?.update()
			} else {
				this.instance = init({
					el: '#tide-interactions-waline',
					serverURL: SITE.interactions.waline.serverURL,
					lang: document.documentElement.lang,
					dark: 'html[data-theme="dark"]',
					reaction: true,
				})
			}
		},
		unload() {
			this.instance?.destroy()
		},
	}

	document.addEventListener('astro:page-load', () => {
		window.tideInteractions.waline.load()
	})
</script>
