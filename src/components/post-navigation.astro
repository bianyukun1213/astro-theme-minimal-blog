---
import { removeTrailingSlash, useTranslations, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'
import type { CollectionEntry } from 'astro:content'
import ChevronLeft from './icons/chevron-left.svg'
import ChevronRight from './icons/chevron-right.svg'
import Link from './link.astro'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	previousPost: CollectionEntry<'blog'> | null
	nextPost: CollectionEntry<'blog'> | null
}

const { previousPost, nextPost } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

function getPostHref(displayId: string) {
	return `${removeTrailingSlash(base)}/${currentLocale}/posts/${displayId}${slash}`
}

const prevHref = previousPost ? getPostHref(previousPost.data.displayId) : null
const nextHref = nextPost ? getPostHref(nextPost.data.displayId) : null
---

{
	(previousPost || nextPost) && (
		<>
			<nav aria-label={m.label_posts_pagination()} class="flex flex-wrap items-start justify-between gap-4">
				<div class="min-w-16 me-auto text-start">
					{previousPost && (
						<>
							<ChevronLeft class="inline-block ltr:scale-x-100 rtl:-scale-x-100" aria-hidden="true" />
							<Link href={prevHref} class="inline-flex items-center justify-start gap-2">
								{previousPost.data.title}
							</Link>
						</>
					)}
				</div>
				<div class="min-w-16 ms-auto text-end">
					{nextPost && (
						<>
							<Link href={nextHref} class="inline-flex items-center justify-end gap-2">
								{nextPost.data.title}
							</Link>
							<ChevronRight class="inline-block ltr:scale-x-100 rtl:-scale-x-100" aria-hidden="true" />
						</>
					)}
				</div>
			</nav>
		</>
	)
}
