---
import Icon from '@components/icon.astro'
import Link from '@components/link.astro'
import Spacer from '@components/spacer.astro'
import { removeTrailingSlash, useTranslations, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'
import type { CollectionEntry } from 'astro:content'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	previousPost: CollectionEntry<'blog'> | null
	nextPost: CollectionEntry<'blog'> | null
}

const { previousPost, nextPost } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

function getPostHref(displayId: string) {
	return `${removeTrailingSlash(base)}/${currentLocale}/posts/${displayId}${slash}`
}
---

{
	(previousPost || nextPost) && (
		<>
			<Spacer axis="vertical" size={10} />
			<nav
				aria-label={m.label_posts_pagination()}
				class="border-t border-border pt-4 flex items-start justify-between gap-4 flex-wrap"
			>
				<div class="min-w-16 max-w-[48%]">
					{previousPost && (
						<div class="flex flex-col items-start gap-1">
							<span class="text-subtle text-sm">{m.label_previous_page()}</span>
							<Link href={getPostHref(previousPost.data.displayId)} class="inline-flex items-center justify-start gap-1">
								<Icon name="chevron-left" class="ltr:scale-x-100 rtl:-scale-x-100" />
								<span>{previousPost.data.title}</span>
							</Link>
						</div>
					)}
				</div>
				<div class="min-w-16 max-w-[48%] text-right ml-auto">
					{nextPost && (
						<div class="flex flex-col items-end gap-1">
							<span class="text-subtle text-sm">{m.label_next_page()}</span>
							<Link href={getPostHref(nextPost.data.displayId)} class="inline-flex items-center justify-end gap-1">
								<span>{nextPost.data.title}</span>
								<Icon name="chevron-right" class="ltr:scale-x-100 rtl:-scale-x-100" />
							</Link>
						</div>
					)}
				</div>
			</nav>
		</>
	)
}