---
import { LOCALES } from '@constants'
import * as messages from '@paraglide/messages'
import { getLocaleDir, removeTrailingSlash, useTranslations, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

type Props = {
	localesOverride?: Locale[]
}

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

const { localesOverride } = Astro.props
const displayLocales = LOCALES.slice().sort((a, b) => {
	if (a === currentLocale) return -1
	if (b === currentLocale) return 1
	return LOCALES.indexOf(a) - LOCALES.indexOf(b)
})

function getLocalizedLocale(localeKey: Locale) {
	type MsgKey = Exclude<keyof typeof messages, 'm'>
	const key = `lang_${localeKey.toLowerCase().replace(/-/g, '_')}` as MsgKey
	const localizationFunc = m[key]
	if (typeof localizationFunc === 'function') {
		return (localizationFunc as () => string)()
	}
	return localeKey
}
---

<div x-data>
	<label class="relative flex items-center gap-2">
		<span class="sr-only">{m.label_select_language()}</span>
		<select
			id="lang-select"
			value="auto"
			autocomplete="off"
			x-on:change={`const opt=$event.target.selectedOptions[0],locale=$event.target.value;opt.dataset.available==='true'?(window.location.href=window.location.href.replace('/'+document.documentElement.lang+'/','/'+locale+'/')):(window.location.href='${removeTrailingSlash(base)}/'+locale+'${slash}');`}
		>
			{
				displayLocales.map((locale) => {
					const available = localesOverride == null || localesOverride.includes(locale)
					return (
						<option
							lang={locale}
							value={locale}
							dir={getLocaleDir(locale)}
							data-available={available ? 'true' : 'false'}
							selected={locale === currentLocale}
							set:html={getLocalizedLocale(locale)}
						/>
					)
				})
			}
		</select>
	</label>
</div>
