---
// https://dev.vk.com/ru/widgets/playlist

interface Props {
	ownerId: string
	playlistId: string
	hash: string
}

const { ownerId, playlistId, hash } = Astro.props
---

<div id={`vk_playlist_${ownerId}_${playlistId}`}></div>
<script defer is:inline data-astro-rerun src="https://vk.com/js/api/openapi.js?169"></script>
<script is:inline define:vars={{ ownerId, playlistId, hash }}>
	const widgetId = `vk_playlist_${ownerId}_${playlistId}`

	function safeDestroy() {
		const widget = document.getElementById(widgetId)
		if (widget?.firstChild) {
			widget.removeChild(widget.firstChild)
			widget.removeAttribute('style')
		}
	}

	document.addEventListener('astro:before-swap', safeDestroy)
	document.addEventListener('astro:page-load', () => {
		const widget = document.getElementById(widgetId)
		if (!widget || widget.firstChild) {
			return
		}
		VK.Widgets.Playlist(widgetId, Number.parseInt(ownerId, 10), Number.parseInt(playlistId, 10), hash)
	})
</script>
