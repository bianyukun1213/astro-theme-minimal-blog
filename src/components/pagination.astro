---
import Icon from '@components/icon.astro'
import Link from '@components/link.astro'
import Spacer from '@components/spacer.astro'
import { useTranslations, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	basePath: string
	totalPages: number
	currentPage: number
}

const { basePath, totalPages, currentPage } = Astro.props

const slash = trailingSlash === 'never' ? '' : '/'

function getPageHref(page: number) {
	if (page === 1) return `${basePath}${slash}`
	return `${basePath}/${page}${slash}`
}

const prevHref = currentPage > 1 ? getPageHref(currentPage - 1) : null
const nextHref = currentPage < totalPages ? getPageHref(currentPage + 1) : null
const pages = Array.from({ length: totalPages }, (_, index) => index + 1)
---

{
	totalPages > 1 && (
		<>
			<Spacer axis="vertical" size={12} />
			<nav
				aria-label={m.label_posts_pagination()}
				class="border-t border-border pt-4 flex items-start justify-between gap-4"
			>
				<div class="min-w-16 text-start">
					{prevHref && (
						<Link href={prevHref} class="inline-flex items-center justify-start gap-2">
							<Icon name="chevron-left" class="ltr:scale-x-100 rtl:-scale-x-100" />
							<span>{m.label_previous_page()}</span>
						</Link>
					)}
				</div>
				<div class="flex items-center gap-2 flex-wrap justify-center">
					{pages.map((page) =>
						page === currentPage ? (
							<span class="text-highlight underline" aria-current="page">
								{page}
							</span>
						) : (
							<Link href={getPageHref(page)}>{page}</Link>
						),
					)}
				</div>
				<div class="min-w-16 text-end">
					{nextHref && (
						<Link href={nextHref} class="inline-flex items-center justify-end gap-2">
							<span>{m.label_next_page()}</span>
							<Icon name="chevron-right" class="ltr:scale-x-100 rtl:-scale-x-100" />
						</Link>
					)}
				</div>
			</nav>
		</>
	)
}
