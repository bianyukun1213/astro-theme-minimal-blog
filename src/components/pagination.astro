---
import { cn, useTranslations, type Locale } from '@utils'
import { trailingSlash } from 'astro:config/client'
import ChevronLeft from './icons/chevron-left.svg'
import ChevronRight from './icons/chevron-right.svg'
import Link from './link.astro'

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	class?: string
	basePath: string
	totalPages: number
	currentPage: number
}

const { class: className, basePath, totalPages, currentPage } = Astro.props

const slash = trailingSlash === 'never' ? '' : '/'

function getPageHref(page: number) {
	return `${basePath}/p/${page}${slash}`
}

const prevHref = currentPage > 1 ? getPageHref(currentPage - 1) : null
const nextHref = currentPage < totalPages ? getPageHref(currentPage + 1) : null
const pages = Array.from({ length: totalPages }, (_, index) => index + 1)
---

{
	totalPages > 1 && (
		<>
			<nav
				aria-label={m.label_posts_pagination()}
				class={cn('flex flex-wrap items-center justify-between gap-4', className)}
			>
				<div class="min-w-16 me-auto text-start">
					{prevHref && (
						<>
							<ChevronLeft class="inline-block align-middle ltr:scale-x-100 rtl:-scale-x-100" aria-hidden="true" />
							<Link class="align-middle ms-1" href={prevHref}>
								{m.btn_previous_page_title()}
							</Link>
						</>
					)}
				</div>
				<div class="flex items-center gap-2 flex-wrap justify-center">
					{pages.map((page) =>
						page === currentPage ? (
							<span class="text-highlight underline" aria-current="page">
								{page}
							</span>
						) : (
							<Link href={getPageHref(page)}>{page}</Link>
						),
					)}
				</div>
				<div class="min-w-16 ms-auto text-end">
					{nextHref && (
						<>
							<Link class="align-middle me-1" href={nextHref}>
								{m.btn_next_page_title()}
							</Link>
							<ChevronRight class="inline-block align-middle ltr:scale-x-100 rtl:-scale-x-100" aria-hidden="true" />
						</>
					)}
				</div>
			</nav>
		</>
	)
}
