---
import type { Locale } from '@utils'
import Spacer from './spacer.astro'
import Waline from './tide-interactions-waline.astro'
import WebmentionJS from './tide-interactions-webmentionjs.astro'

const currentLocale = Astro.currentLocale as Locale

interface Props {
	webmentions?: boolean
}

const { webmentions = true } = Astro.props
---

<aside id="tide-page-interactions" x-data="{active:'waline'}">
	<div class="border-b border-border pb-4">
		<h2 class="inline-block m-0 me-2 font-medium text-xl md:text-2xl lg:text-3xl text-highlight">
			<label for="tide-select-active-interactions">互动</label>
		</h2>
		<select id="tide-select-active-interactions" name="tide-active-interactions" x-model="active">
			<option value="waline">Waline</option>
			{webmentions && <option value="webmentionjs">Webmentions</option>}
		</select>
	</div>
	<Spacer axis="vertical" size={4} />
	<div id="tide-active-interactions">
		<div x-show="active==='waline'">
			<Waline />
		</div>
		{
			webmentions && (
				<div x-show="active==='webmentionjs'">
					<WebmentionJS />
				</div>
			)
		}
	</div>
</aside>
