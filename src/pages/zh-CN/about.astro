---
import Link from '@components/link.astro'
import TabContainer from '@components/tab-container.astro'
import Tab from '@components/tab.astro'
import Page from '@layouts/page.astro'
---

<Page title="关于">
	<p>
		这是
		<Link href="https://yukun.bio/" target="_blank" rel="noopener">边宇琨</Link>
		的个人博客。
	</p>
	<TabContainer>
		<Tab name="music-playlist" label="网易云音乐" checked={true}>
			<iframe
				class="mx-auto"
				width="330"
				height="450"
				src="//music.163.com/outchain/player?type=0&id=8789695885&auto=0&height=430"></iframe>
			<script></script>
		</Tab>
		<Tab name="music-playlist" label="YouTube Music">
			<Link
				href="https://music.youtube.com/playlist?list=PL4b8BRd_yTniafEC1D1hsCTAESIygnjyc&feature=shared"
				target="_blank"
				rel="noopener">在 YouTube Music 上聆听</Link
			>
		</Tab>
	</TabContainer>
</Page>
