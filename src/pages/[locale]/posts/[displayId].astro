---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Aside from '@components/aside.astro'
import Icon from '@components/icon.astro'
import Mf2Meta from '@components/mf2-meta.astro'
import PostNavigation from '@components/post-navigation.astro'
import Prose from '@components/prose.astro'
import Protected from '@components/protected.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import TagLinks from '@components/tag-links.astro'
import TideInteractions from '@components/tide-interactions.astro'
import { getAuthors, SITE } from '@constants'
import Layout from '@layouts/layout.astro'
import * as messages from '@paraglide/messages'
import {
	defaultDateFormat,
	filterDrafts,
	getLocaleFromFilePath,
	getLocalizedTagName,
	getPostsByLocale,
	isoDateFormat,
	removeTrailingSlash,
	sortAsc,
	useTranslations,
	type Locale,
} from '@utils'
import { Picture } from 'astro:assets'
import { getCollection, render } from 'astro:content'

export const prerender = false

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const { displayId } = Astro.params
let allPosts = await getCollection('blog')
allPosts = filterDrafts(allPosts)
const post = allPosts.find((p) => p.data.displayId === displayId && getLocaleFromFilePath(p.filePath) === currentLocale)
if (!post) {
	return new Response(null, { status: 404, statusText: 'Not Found' })
}

const base = import.meta.env.BASE_URL

const { data: postData } = post
const url = Astro.url
const title = postData.title || m.site_title()
const description = postData.description || m.site_description()
const datePublished = isoDateFormat(postData.date)
const dateModified = isoDateFormat(postData.updated)
const authors = getAuthors(currentLocale)
const authorSlugs = postData.authors
const postAuthors = authors.filter((author) => authorSlugs.includes(author.slug))
const tagNames = postData.tags.map((tagSlug) => getLocalizedTagName(tagSlug, currentLocale))
const validImage = postData.image || m.site_default_og_image()
let copyright = ''
if (postData.copyright) {
	type crKey = Exclude<keyof typeof messages, 'm'>
	const key = `copyright_${postData.copyright.toLowerCase().replace(/(-|\s|\.)/g, '_')}` as crKey
	const localizationFunc = m[key]
	if (typeof localizationFunc === 'function') {
		copyright = (localizationFunc as () => string)()
	} else {
		copyright = postData.copyright
	}
}
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@language': currentLocale,
	headline: title,
	description,
	datePublished,
	dateModified,
	mainEntityOfPage: url,
	author: postAuthors.map((author) => ({
		'@type': 'Person',
		name: author.name,
	})),
	image: [
		validImage.startsWith('http://') || validImage.startsWith('https://')
			? validImage
			: new URL(`${removeTrailingSlash(base)}${validImage}`, SITE.url),
	],
}
const { Content } = await render(post)
const dataAttributes: DOMStringMap = {}
if (postData.searchIndex) dataAttributes['data-pagefind-body'] = ''

const sortedLocalePosts = sortAsc(getPostsByLocale(allPosts, currentLocale))
const currentPostIndex = sortedLocalePosts.findIndex((entry) => entry.id === post.id)
const previousPost = sortedLocalePosts.slice(currentPostIndex + 1).find((p) => !p.data.hidden) ?? null
const nextPost = sortedLocalePosts.slice(0, currentPostIndex).findLast((p) => !p.data.hidden) ?? null

Astro.locals.localesOverride = allPosts
	.filter((p) => p.data.displayId === postData.displayId)
	.map((p) => getLocaleFromFilePath(p.filePath)) as Locale[]
---

<Layout>
	<Seo slot="seo" titleOverride={title} {description} image={postData.image} noIndex={postData.hidden}>
		<meta name="twitter:label1" value={m.label_authors()} />
		<!-- <meta name="twitter:data1" data-pagefind-meta="author" value={postAuthors.map((author) => author.name).join(',')} /> -->
		<meta name="twitter:data1" value={postAuthors.map((author) => author.name).join(', ')} />
		<meta name="twitter:label2" value={m.label_tags()} />
		<meta name="twitter:data2" value={tagNames.join(', ')} />
		<meta name="article:published_time" content={datePublished} />
		<meta name="article:modified_time" content={dateModified} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Seo>
	<SkipNavContent {...dataAttributes}>
		<Prose class="h-entry">
			{
				postData.image && (
					<>
						<figure class="not-prose relative">
							<Picture
								pictureAttributes={{ class: 'not-prose' }}
								class="not-prose block w-full aspect-3/1 mb-2 object-cover"
								src={postData.image}
								alt={postData.imageAlt}
								layout="none"
								inferSize
							/>
							{postData.imageCaption && (
								<figcaption class="not-prose absolute inset-e-0 bottom-0 max-w-full px-1 bg-bg text-text text-sm rounded-ss-md text-nowrap overflow-auto">
									<Icon name="image" class="inline-block" />
									<span>{postData.imageCaption}</span>
								</figcaption>
							)}
						</figure>
						<Spacer axis="vertical" size={2} />
					</>
				)
			}
			<h1 class="p-name mb-0!" data-pagefind-meta="title">{title}</h1>
			<Spacer axis="vertical" size={4} />
			<div class="text-faded">
				<div>
					<span>{defaultDateFormat(postData.date, currentLocale)} — </span><TagLinks slugs={postData.tags} />
				</div>
				{copyright && <div>{copyright}</div>}
				<div class="p-summary">{description}</div>
			</div>
			<Mf2Meta
				meta={{
					url: url.toString(),
					description,
					authors: postAuthors,
					datePublished,
					dateUpdated: dateModified,
					tagNames,
					pLocation: postData.pLocation,
					uInReplyTo: postData.uInReplyTo,
					uLikeOf: postData.uLikeOf,
					uRepostOf: postData.uRepostOf,
					uSyndication: postData.uSyndication,
				}}
			/>
			<Spacer axis="vertical" size={12} />
			<Content components={{ Aside, Protected }} />
		</Prose>
		<Spacer axis="vertical" size={12} />
		<PostNavigation previousPost={previousPost} nextPost={nextPost} />
		<Spacer axis="vertical" size={12} />
		{postData.interactions && <TideInteractions />}
	</SkipNavContent>
</Layout>
