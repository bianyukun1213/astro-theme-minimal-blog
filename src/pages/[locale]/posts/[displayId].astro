---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Aside from '@components/aside.astro'
import HCard from '@components/HCard.astro'
import Playground from '@components/playground.astro'
import PLocation from '@components/PLocation.astro'
import PostNavigation from '@components/post-navigation.astro'
import Prose from '@components/prose.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import TagLinks from '@components/tag-links.astro'
import { getAuthors, SITE } from '@constants'
import Layout from '@layouts/layout.astro'
import {
defaultDateFormat,
getLocaleFromFilePath,
getLocalizedTagName,
getPostsByLocale,
isoDateFormat,
removeTrailingSlash,
sortAsc,
useTranslations,
type Locale,
} from '@utils'
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'

export const getStaticPaths = (async () => {
	const allPosts = await getCollection('blog')
	return allPosts.map((post) => {
		const postLocale = getLocaleFromFilePath(post.filePath)
		return {
			params: {
				displayId: post.data.displayId,
				locale: postLocale,
			},
			props: {
				post,
			},
		}
	})
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const { post } = Astro.props

const base = import.meta.env.BASE_URL

const { data: postData } = post
const url = Astro.url
const title = postData.title || m.site_title()
const description = postData.description || m.site_description()
const datePublished = isoDateFormat(postData.date)
const dateModified = isoDateFormat(postData.updated)
const authors = getAuthors(currentLocale)
const authorSlugs = postData.authors
const postAuthors = authors.filter((author) => authorSlugs.includes(author.slug))
const tagNames = postData.tags.map((tagSlug) => getLocalizedTagName(tagSlug, currentLocale))
const validImage = postData.image || m.site_default_og_image()
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@language': currentLocale,
	headline: title,
	description,
	datePublished,
	dateModified,
	mainEntityOfPage: url,
	author: postAuthors.map((author) => ({ '@type': 'Person', name: author.name })),
	image: [
		validImage.startsWith('http://') || validImage.startsWith('https://')
			? validImage
			: new URL(`${removeTrailingSlash(base)}${validImage}`, SITE.url),
	],
}
const { Content } = await render(post)

const allPosts = await getCollection('blog')
const sortedLocalePosts = sortAsc(getPostsByLocale(allPosts, currentLocale))
const currentPostIndex = sortedLocalePosts.findIndex((entry) => entry.id === post.id)
const previousPost = currentPostIndex < sortedLocalePosts.length - 1 ? sortedLocalePosts[currentPostIndex + 1] : null
const nextPost = currentPostIndex > 0 ? sortedLocalePosts[currentPostIndex - 1] : null

Astro.locals.localesOverride = allPosts
	.filter((p) => p.data.displayId === postData.displayId)
	.map((p) => getLocaleFromFilePath(p.filePath)) as Locale[]
---

<Layout>
	<Seo slot="seo" titleOverride={title} {description} image={postData.image}>
		<meta name="twitter:label1" value={m.label_authors()} />
		<!-- <meta name="twitter:data1" data-pagefind-meta="author" value={postAuthors.map((author) => author.name).join(',')} /> -->
		<meta name="twitter:data1" value={postAuthors.map((author) => author.name).join(', ')} />
		<meta name="twitter:label2" value={m.label_tags()} />
		<meta
			name="twitter:data2"
			value={tagNames.join(', ')}
		/>
		<meta name="article:published_time" content={datePublished} />
		<meta name="article:modified_time" content={dateModified} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Seo>
	<SkipNavContent searchIndex={postData.searchIndex}>
		<Prose class="h-entry">
			<h1 class="p-name mb-0!" data-pagefind-meta="title">{title}</h1>
			<Spacer axis="vertical" size={4} />
			<div class="text-faded">
				{defaultDateFormat(postData.date, currentLocale)} — <TagLinks slugs={postData.tags} />
			</div>
			<a class="u-url hidden" href={url}>{url}</a>
			<span class="p-summary hidden">{description}</span>
			{
				authors.map((a) => {
					return (
						<HCard
							hCard={{
								pName: a.name,
								uPhoto: a.photo,
								uUrl: a.url,
								uEmail: a.email,
								pNote: a.note,
							}},
							isAuthorCard={true}
						/>
					)
				})
			}
			<time class="dt-published hidden" data-pagefind-meta="published_time" datetime={datePublished}
				>{datePublished}</time
			>
			<time class="dt-updated hidden" data-pagefind-meta="modified_time" datetime={dateModified}>{dateModified}</time>
			{
				tagNames.map((tagName) => {
					return <span class="p-category hidden">{tagName}</span>
				})
			}
			{postData.pLocation && <PLocation intent={postData.pLocation.pStreetAddress ? 'h-adr' : 'h-geo'} pLocation={postData.pLocation} />}
			{
				postData.uInReplyTo && postData.uInReplyTo.map((target) => {
					return <a class="u-in-reply-to hidden" href={target} target="_blank" rel="noopener noreferrer">{target}</a>
				})
			}
			{
				postData.uLikeOf && postData.uLikeOf.map((target) => {
					return <a class="u-like-of hidden" href={target} target="_blank" rel="noopener noreferrer">{target}</a>
				})
			}
			{
				postData.uRepostOf && postData.uRepostOf.map((target) => {
					return <a class="u-repost-of hidden" href={target} target="_blank" rel="noopener noreferrer">{target}</a>
				})
			}
			{
				postData.uSyndication && postData.uSyndication.map((syndication) => {
					return <a class="u-syndication hidden" href={syndication} target="_blank" rel="noopener noreferrer">{new URL(syndication).hostname}</a>
				})
			}
			<Spacer axis="vertical" size={12} />
			<Content components={{ Aside, Playground }} />
		</Prose>
		<PostNavigation previousPost={previousPost} nextPost={nextPost} />
	</SkipNavContent>
</Layout>
