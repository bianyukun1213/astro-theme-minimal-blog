---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Aside from '@components/aside.astro'
import Collapse from '@components/collapse.astro'
import ImageIcon from '@components/icons/image.svg'
import Mf2Meta from '@components/mf2-meta.astro'
import NeteaseMusic from '@components/netease-music.astro'
import PostNavigation from '@components/post-navigation.astro'
import Prose from '@components/prose.astro'
import Protected from '@components/protected.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import TabContainer from '@components/tab-container.astro'
import Tab from '@components/tab.astro'
import TagLinks from '@components/tag-links.astro'
import TideImageMasonry from '@components/tide-image-masonry.astro'
import TideInteractions from '@components/tide-interactions.astro'
import TideMasonryItem from '@components/tide-masonry-item.astro'
import TidePicture from '@components/tide-picture.astro'
import VkMusic from '@components/vk-music.astro'
import YouTube from '@components/youtube.astro'
import { getAuthors, SITE } from '@constants'
import Layout from '@layouts/layout.astro'
import * as messages from '@paraglide/messages'
import {
	defaultDateFormat,
	filterDrafts,
	getLocaleFromFilePath,
	getLocalizedTagName,
	getPostsByLocale,
	isoDateFormat,
	removeTrailingSlash,
	sortAsc,
	sortSticky,
	useTranslations,
	type Locale,
} from '@utils'
import { getCollection, render } from 'astro:content'

export const prerender = false

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const { displayId } = Astro.params
let allPosts = await getCollection('blog')
allPosts = filterDrafts(allPosts)
const post = allPosts.find((p) => p.data.displayId === displayId && getLocaleFromFilePath(p.filePath) === currentLocale)
if (!post) {
	return new Response(null, { status: 404, statusText: 'Not Found' })
}

const base = import.meta.env.BASE_URL

const url = Astro.url
const title = post.data.title || m.site_title()
const description = post.data.description || m.site_description()
const datePublished = isoDateFormat(post.data.date)
const dateModified = isoDateFormat(post.data.updated)
const authors = getAuthors(currentLocale)
const authorSlugs = post.data.authors
const postAuthors = authors.filter((author) => authorSlugs.includes(author.slug))
const tagNames = post.data.tags.map((tagSlug) => getLocalizedTagName(tagSlug, currentLocale))
const validImage = post.data.image || m.site_default_og_image()
let copyright = ''
if (post.data.copyright) {
	type crKey = Exclude<keyof typeof messages, 'm'>
	const key = `copyright_${post.data.copyright.toLowerCase().replace(/(-|\s|\.)/g, '_')}` as crKey
	const localizationFunc = m[key]
	if (typeof localizationFunc === 'function') {
		copyright = (localizationFunc as () => string)()
	} else {
		copyright = post.data.copyright
	}
}
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@language': currentLocale,
	headline: title,
	description,
	datePublished,
	dateModified,
	mainEntityOfPage: url,
	author: postAuthors.map((author) => ({
		'@type': 'Person',
		name: author.name,
	})),
	image: [
		validImage.startsWith('http://') || validImage.startsWith('https://')
			? validImage
			: new URL(`${removeTrailingSlash(base)}${validImage}`, SITE.url),
	],
}
const { Content } = await render(post)
const dataAttributes: DOMStringMap = {}
if (post.data.searchIndex) dataAttributes['data-pagefind-body'] = ''

const sortedLocalePosts = sortSticky(sortAsc(getPostsByLocale(allPosts, currentLocale)))
const currentPostIndex = sortedLocalePosts.findIndex((entry) => entry.id === post.id)
const previousPost = sortedLocalePosts.slice(currentPostIndex + 1).find((p) => !p.data.hidden) ?? null
const nextPost = sortedLocalePosts.slice(0, currentPostIndex).findLast((p) => !p.data.hidden) ?? null

Astro.locals.localesOverride = allPosts
	.filter((p) => p.data.displayId === post.data.displayId)
	.map((p) => getLocaleFromFilePath(p.filePath)) as Locale[]

const components = {
	Aside,
	Protected,
	TideImageMasonry,
	TideMasonryItem,
	TidePicture,
	TabContainer,
	Tab,
	Collapse,
	YouTube,
	NeteaseMusic,
	VkMusic,
}
---

<Layout>
	<Seo
		slot="seo"
		titleOverride={title}
		keywords={post.data.keywords}
		{description}
		image={post.data.image || post.data.cover}
		noIndex={post.data.hidden}
	>
		<meta name="twitter:label1" value={m.label_authors()} />
		<!-- <meta name="twitter:data1" data-pagefind-meta="author" value={postAuthors.map((author) => author.name).join(',')} /> -->
		<meta name="twitter:data1" value={postAuthors.map((author) => author.name).join(', ')} />
		<meta name="twitter:label2" value={m.label_tags()} />
		<meta name="twitter:data2" value={tagNames.join(', ')} />
		<meta name="article:published_time" content={datePublished} />
		<meta name="article:modified_time" content={dateModified} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Seo>
	<SkipNavContent {...dataAttributes}>
		<PostNavigation class="-mt-4 sm:mt-0" previousPost={previousPost} nextPost={nextPost} />
		<Spacer class="sm:hidden" axis="vertical" size={4} />
		<Spacer class="hidden sm:block" axis="vertical" size={8} />
		<Prose class="h-entry">
			<div transition:name={`post-title-${post.data.displayId}`}>
				{
					(post.data.cover || post.data.image) && (
						<>
							<figure class="not-prose relative">
								<img class="block w-full aspect-3/1 object-cover" src={post.data.cover || post.data.image} alt={post.data.coverAlt ?? ''} title={post.data.coverTitle} />
								{(post.data.coverTitle || post.data.coverCaption) && (
									<figcaption class="absolute inset-e-0 bottom-0 max-w-full px-1 bg-bg text-text text-sm rounded-ss-md text-nowrap overflow-auto">
										<ImageIcon class="inline-block align-middle w-4 ht-4" aria-hidden="true" />
										<span class="align-middle ms-1">{post.data.coverTitle || post.data.coverCaption}</span>
									</figcaption>
								)}
							</figure>
							<Spacer axis="vertical" size={2} />
						</>
					)
				}
				<h1 class="p-name mb-0! text-highlight" data-pagefind-meta="title">
					{`${post.data.draft ? '[' + m.label_draft() + '] ' : ''}${title}`}
				</h1>
			</div>
			<Spacer axis="vertical" size={4} />
			<div class="text-faded">
				<div transition:name={`post-tags-${post.data.displayId}`}>
					<span>{defaultDateFormat(post.data.date, currentLocale)} — </span><TagLinks slugs={post.data.tags} />
				</div>
				{copyright && <div>{copyright}</div>}
				<div class="p-summary" transition:name={`post-description-${post.data.displayId}`}>{description}</div>
			</div>
			<Mf2Meta
				meta={{
					url: url.toString(),
					description,
					authors: postAuthors,
					datePublished,
					dateUpdated: dateModified,
					tagNames,
					pLocation: post.data.pLocation,
					uInReplyTo: post.data.uInReplyTo,
					uLikeOf: post.data.uLikeOf,
					uRepostOf: post.data.uRepostOf,
					uSyndication: post.data.uSyndication,
				}}
			/>
			<Spacer axis="vertical" size={12} />
			<div class="e-content">
				<Content {components} />
			</div>
		</Prose>
		<Spacer axis="vertical" size={12} />
		<PostNavigation previousPost={previousPost} nextPost={nextPost} />
		<Spacer axis="vertical" size={12} />
		{post.data.interactions && <TideInteractions alternativeUrls={post.data.alternativeUrls} />}
	</SkipNavContent>
</Layout>
