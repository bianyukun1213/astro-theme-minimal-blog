---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Pagination from '@components/pagination.astro'
import PostListItem from '@components/post-list-item.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { LOCALES, POSTS_PER_PAGE } from '@constants'
import Layout from '@layouts/layout.astro'
import {
	filterDrafts,
	filterHidden,
	getLocaleFromFilePath,
	getPostsByLocale,
	removeTrailingSlash,
	sortAsc,
	useTranslations,
	type Locale,
} from '@utils'
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'

export const getStaticPaths = (async ({ paginate }) => {
	let allPosts = await getCollection('blog')
	allPosts = filterDrafts(allPosts)
	allPosts = filterHidden(allPosts)
	const localesInUse = [...new Set(allPosts.map((post) => getLocaleFromFilePath(post.filePath)))]
	return localesInUse.flatMap((locale) => {
		const localePosts = getPostsByLocale(allPosts, locale)
		const posts = sortAsc(localePosts)
		return paginate(posts, {
			pageSize: POSTS_PER_PAGE,
			params: { locale },
		})
	})
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const { page } = Astro.props

const base = import.meta.env.BASE_URL

const posts = page.data
const currentPage = page.currentPage
const totalPages = page.lastPage

const postsBasePath = `${removeTrailingSlash(base)}/${currentLocale}/posts`
const pageTitle = currentPage === 1 ? m.label_all_posts() : m.label_all_posts_pagenum({ pageNum: currentPage })

const localesOverride: Locale[] = []
let allPosts = await getCollection('blog')
allPosts = filterDrafts(allPosts)
allPosts = filterHidden(allPosts)
for (const locale of LOCALES) {
	const localePosts = getPostsByLocale(allPosts, locale)
	const localePostsCount = localePosts.length
	const pagesCount = Math.ceil(localePostsCount / page.size)
	if (pagesCount >= page.currentPage) {
		localesOverride.push(locale)
	}
}
Astro.locals.localesOverride = localesOverride
---

<Layout>
	<Seo slot="seo" title={pageTitle} />
	<SkipNavContent>
		<h1 class="sr-only">{m.site_title()}</h1>
		<div class="border-b border-border pb-4 flex justify-between items-center">
			<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">{pageTitle}</h2>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-12 flex-col">
			{posts.map((post) => <PostListItem post={post} />)}
		</div>
		<Spacer axis="vertical" size={12} />
		<Pagination basePath={postsBasePath} totalPages={totalPages} currentPage={currentPage} />
	</SkipNavContent>
</Layout>
