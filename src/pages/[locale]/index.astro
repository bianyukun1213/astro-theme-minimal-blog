---
import { Content as Hero } from '@assets/hero.mdx'
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import HCard from '@components/h-card.astro'
import Link from '@components/link.astro'
import PostListItem from '@components/post-list-item.astro'
import Prose from '@components/prose.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { getAuthors, LOCALES, POSTS_PER_PAGE } from '@constants'
import Layout from '@layouts/layout.astro'
import {
	filterDrafts,
	filterHidden,
	getPostsByLocale,
	removeTrailingSlash,
	sortAsc,
	useTranslations,
	type Locale,
} from '@utils'
import type { GetStaticPaths } from 'astro'
import { trailingSlash } from 'astro:config/client'
import { getCollection } from 'astro:content'

export const getStaticPaths = (async () => {
	return LOCALES.map((locale) => ({
		params: { locale },
	}))
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

let allPosts = await getCollection('blog')
allPosts = filterDrafts(allPosts)
allPosts = filterHidden(allPosts)
allPosts = getPostsByLocale(allPosts, currentLocale)
allPosts = sortAsc(allPosts)
const posts = allPosts.slice(0, POSTS_PER_PAGE)

const defaultAuthor = getAuthors(currentLocale)[0]
---

<Layout>
	<Seo slot="seo" />
	<SkipNavContent>
		<h1 class="sr-only">{m.site_title()}</h1>
		<HCard
			hCard={{
				pName: defaultAuthor.name,
				uPhoto: defaultAuthor.photo,
				uUrls: defaultAuthor.urls,
				uEmail: defaultAuthor.email,
				pNote: defaultAuthor.note,
			}}
			,
			isAuthorCard={true}
		/>
		<Prose>
			<Hero />
		</Prose>
		<Spacer axis="vertical" size={32} />
		<section>
			<div class="border-b border-border pb-4 flex justify-between items-center">
				<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">{m.label_latest_posts()}</h2>
				<div>
					<Link href={`${removeTrailingSlash(base)}/${currentLocale}/posts/p/1${slash}`}>{m.label_all_posts()}</Link>
				</div>
			</div>
			<Spacer axis="vertical" size={8} />
			<div class="flex gap-12 flex-col">
				{posts.map((post) => <PostListItem post={post} />)}
			</div>
		</section>
		<Spacer axis="vertical" size={32} />
	</SkipNavContent>
</Layout>
