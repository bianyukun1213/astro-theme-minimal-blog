---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { LOCALES } from '@constants'
import Layout from '@layouts/layout.astro'
import { getPostsByLocale, getTags, removeTrailingSlash, useTranslations, type Locale } from '@utils'
import type { GetStaticPaths } from 'astro'
import { trailingSlash } from 'astro:config/client'
import { getCollection } from 'astro:content'

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

export const getStaticPaths = (async () => {
	return LOCALES.map((locale) => ({
		params: { locale },
	}))
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const allPosts = await getCollection('blog')
const posts = getPostsByLocale(allPosts, currentLocale)
const tags = getTags(posts, currentLocale)
---

<Layout>
	<Seo slot="seo" title="Tags" />
	<SkipNavContent>
		<div class="border-b border-border pb-4 flex justify-between items-center">
			<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">Tags</h2>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-6 flex-col">
			{
				tags.map(({ tagName, slug, count }) => (
					<Link variant="highlight" href={`${removeTrailingSlash(base)}/${currentLocale}/tags/${slug}${slash}`}>
						{tagName} ({count})
					</Link>
				))
			}
		</div>
	</SkipNavContent>
</Layout>
