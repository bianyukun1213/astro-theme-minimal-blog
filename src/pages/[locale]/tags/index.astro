---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { LOCALES } from '@constants'
import Layout from '@layouts/layout.astro'
import {
	filterDrafts,
	filterHidden,
	getPostsByLocale,
	getTags,
	removeTrailingSlash,
	useTranslations,
	type Locale,
} from '@utils'
import type { GetStaticPaths } from 'astro'
import { trailingSlash } from 'astro:config/client'
import { getCollection } from 'astro:content'

export const getStaticPaths = (async () => {
	return LOCALES.map((locale) => ({
		params: { locale },
	}))
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

let allPosts = await getCollection('blog')
allPosts = filterDrafts(allPosts)
allPosts = filterHidden(allPosts)
allPosts = getPostsByLocale(allPosts, currentLocale)
const tags = getTags(allPosts, currentLocale)
---

<Layout>
	<Seo slot="seo" title={m.label_tags()} />
	<SkipNavContent>
		<h1 class="sr-only">{m.site_title()}</h1>
		<div class="border-b border-border pb-4 flex justify-between items-center">
			<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">{m.label_tags()}</h2>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-12 flex-col items-start">
			{
				tags.map(({ tagName, slug, count }) => (
					<Link variant="highlight" href={`${removeTrailingSlash(base)}/${currentLocale}/tags/${slug}/p/1${slash}`}>
						{m.label_tags_tagname_count({ tagName, count })}
					</Link>
				))
			}
		</div>
	</SkipNavContent>
</Layout>
