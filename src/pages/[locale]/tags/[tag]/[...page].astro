---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import Pagination from '@components/pagination.astro'
import PostListItem from '@components/post-list-item.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { LOCALES, POSTS_PER_PAGE, SITE, type TagSlug } from '@constants'
import Layout from '@layouts/layout.astro'
import {
	getLocaleFromFilePath,
	getPostsByLocale,
	getPostsByTag,
	getTags,
	removeTrailingSlash,
	useTranslations,
	type Locale,
} from '@utils'
import type { GetStaticPaths, Page } from 'astro'
import { trailingSlash } from 'astro:config/client'
import { getCollection, type CollectionEntry } from 'astro:content'

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection('blog')
	const localesInUse = [...new Set(allPosts.map((post) => getLocaleFromFilePath(post.filePath)))]
	return localesInUse.flatMap((locale) => {
		const localePosts = getPostsByLocale(allPosts, locale)
		const usedTags = getTags(localePosts, locale)
		return usedTags.flatMap(({ slug: tagSlug, tagName }) => {
			const posts = getPostsByTag(localePosts, tagSlug)
			return paginate(posts, {
				pageSize: POSTS_PER_PAGE,
				params: { locale, tag: tagSlug },
				props: { tagName, slug: tagSlug },
			})
		})
	})
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale
const m = useTranslations(currentLocale)

interface Props {
	page: Page<CollectionEntry<'blog'>>
	tagName: string
	slug: TagSlug
}

const { page, tagName, slug } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

const posts = page.data
const currentPage = page.currentPage
const totalPages = page.lastPage

const tagsBasePath = `${removeTrailingSlash(base)}/${currentLocale}/tags`
const tagBasePath = `${tagsBasePath}/${slug}`
const pageTitle =
	currentPage === 1 ? m.label_tag_tagname({ tagName }) : m.label_tag_tagname_pagenum({ tagName, pageNum: currentPage })

const localesOverride: Locale[] = []
const allPosts = await getCollection('blog')
const postsByTag = getPostsByTag(allPosts, slug)
for (const locale of LOCALES) {
	const postsByTagAndLocale = getPostsByLocale(postsByTag, locale)
	const postsByTagAndLocaleCount = postsByTagAndLocale.length
	const pagesCount = Math.ceil(postsByTagAndLocaleCount / page.size)
	if (pagesCount >= page.currentPage) {
		localesOverride.push(locale)
	}
}
Astro.locals.localesOverride = localesOverride
---

<Layout>
	<Seo slot="seo" title={pageTitle} />
	<SkipNavContent>
		<h1 class="sr-only">{m.site_title()}</h1>
		<div class="border-b border-border pb-4 flex justify-between items-center">
			<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">{pageTitle}</h2>
			<div><Link href={`${tagsBasePath}${slash}`}>{m.label_all_tags()}</Link></div>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-10 flex-col">
			{posts.map((post) => <PostListItem post={post} />)}
		</div>
		<Pagination basePath={tagBasePath} totalPages={totalPages} currentPage={currentPage} />
	</SkipNavContent>
</Layout>
