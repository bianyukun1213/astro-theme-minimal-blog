---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import Pagination from '@components/pagination.astro'
import PostListItem from '@components/post-list-item.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { FRONTMATTER_TAGS, POSTS_PER_PAGE, SITE, type FrontmatterTag } from '@constants'
import Layout from '@layouts/layout.astro'
import { getLocaleFromFilePath, getPostsByLocale, getPostsByTag, removeTrailingSlash, type Locale } from '@utils'
import type { GetStaticPaths, Page } from 'astro'
import { trailingSlash } from 'astro:config/client'
import { getCollection, type CollectionEntry } from 'astro:content'

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection('blog')
	const localesInUse = [...new Set(allPosts.map((post) => getLocaleFromFilePath(post.filePath)))]
	return localesInUse.flatMap((locale) => {
		const localePosts = getPostsByLocale(allPosts, locale)
		return [...FRONTMATTER_TAGS].flatMap(([tagName, tagSlug]) => {
			const posts = getPostsByTag(localePosts, tagName)
			return paginate(posts, {
				pageSize: POSTS_PER_PAGE,
				params: { locale, tag: tagSlug },
				props: { tagName, tagSlug },
			})
		})
	})
}) satisfies GetStaticPaths

const currentLocale = Astro.currentLocale as Locale

interface Props {
	page: Page<CollectionEntry<'blog'>>
	tagName: FrontmatterTag
	tagSlug: string
}

const { page, tagName, tagSlug } = Astro.props
const posts = page.data
const currentPage = page.currentPage
const totalPages = page.lastPage

const tagsBasePath = `${removeTrailingSlash(base)}/${currentLocale}/tags`
const tagBasePath = `${tagsBasePath}/${tagSlug}`
const pageTitle = currentPage === 1 ? `Tag: ${tagName}` : `Tag: ${tagName} - Page ${currentPage}`
---

<Layout>
	<Seo slot="seo" title={pageTitle} />
	<SkipNavContent>
		<h1 class="sr-only">{SITE.title}</h1>
		<div class="border-b border-border pb-4 flex justify-between items-center">
			<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">{pageTitle}</h2>
			<div><Link href={`${tagsBasePath}${slash}`}>See all tags</Link></div>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-10 flex-col">
			{posts.map((post) => <PostListItem post={post} />)}
		</div>
		<Pagination basePath={tagBasePath} totalPages={totalPages} currentPage={currentPage} />
	</SkipNavContent>
</Layout>
