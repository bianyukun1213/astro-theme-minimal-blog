---
import Link from '@components/link.astro'
import NeteaseMusic from '@components/netease-music.astro'
import TabContainer from '@components/tab-container.astro'
import Tab from '@components/tab.astro'
import Page from '@layouts/page.astro'
---

<Page title="אודות">
	<p>
		זהו הבלוג האישי של
		<Link href="https://yukun.bio/" target="_blank" rel="noopener">ביאן יוקון</Link>
		.
	</p>
	<TabContainer>
		<Tab name="playlist" label="YouTube Music" checked={true}>
			<Link
				href="https://music.youtube.com/playlist?list=PL4b8BRd_yTniafEC1D1hsCTAESIygnjyc&feature=shared"
				target="_blank"
				rel="noopener">להאזין ב-YouTube Music</Link
			>
		</Tab>
		<Tab name="playlist" label="NetEase Music">
			<NeteaseMusic id="8789695885" type="playlist" />
		</Tab>
	</TabContainer>
</Page>
