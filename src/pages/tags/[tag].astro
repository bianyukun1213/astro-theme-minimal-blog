---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import PostListItem from '@components/post-list-item.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { FRONTMATTER_TAGS, SITE } from '@constants'
import Layout from '@layouts/layout.astro'
import { getPostsByTag, removeTrailingSlash } from '@utils'
import { trailingSlash } from 'astro:config/client'
import { getCollection } from 'astro:content'

/**
 * 1. Generate static pages for all tags.
 * 2. Each tag page will have a list of entries associated with that tag.
 */
export async function getStaticPaths() {
	const entries = await getCollection('blog')

	let result = []

	for (const [tagName, tagSlug] of FRONTMATTER_TAGS) {
		const postsWithTag = getPostsByTag(entries, tagName)

		result.push({
			params: {
				tag: tagSlug,
			},
			props: {
				tagName,
				tagSlug,
				postsWithTag,
			},
		})
	}

	return result
}

const { tagName, postsWithTag } = Astro.props

const base = import.meta.env.BASE_URL
const slash = trailingSlash === 'never' ? '' : '/'
---

<Layout>
	<Seo slot="seo" title={`Tag: ${tagName}`} />
	<SkipNavContent>
		<h1 class="sr-only">{SITE.title}</h1>
		<div class="border-b border-border pb-4 flex justify-between items-center">
			<h2 class="font-medium text-xl md:text-2xl lg:text-3xl text-highlight">Tag: {tagName}</h2>
			<div><Link href={`${removeTrailingSlash(base)}/tags${slash}`}>See all tags</Link></div>
		</div>
		<Spacer axis="vertical" size={8} />
		<div class="flex gap-10 flex-col">
			{postsWithTag.map(({ data: post }) => <PostListItem post={post} />)}
		</div>
	</SkipNavContent>
</Layout>
