---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import PostListItem from '@components/post-list-item.astro'
import Seo from '@components/seo.astro'
import Layout from '@layouts/layout.astro'
import { sortAsc } from '@utils'
import { getCollection } from 'astro:content'

const posts = sortAsc(await getCollection('blog'))
---

<Layout>
	<Seo slot="seo" title="Blog" />
	<SkipNavContent>
		<h1 class="sr-only">Blog</h1>
		<div class="flex gap-10 flex-col">
			{posts.map(({ data: post }) => <PostListItem post={post} />)}
		</div>
	</SkipNavContent>
</Layout>
