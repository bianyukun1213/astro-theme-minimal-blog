---
import SkipNavLink from '@components/a11y/skip-nav-link.astro'
import BackToTop from '@components/back-to-top.astro'
import Footer from '@components/footer.astro'
import Header from '@components/header.astro'
import ThemeIcons from '@components/theme-icons.astro'
import ThemeProvider from '@components/theme-provider.astro'
import TideDialogImageViewer from '@components/tide-dialog-image-viewer.astro'
import { SITE } from '@constants'
import { defaultTheme } from '@generated/tailwindcss'
import '@styles/global.css'
import type { TideMeta } from '@types'
import { getLocaleDir, useTranslations, type Locale } from '@utils'
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

const currentLocale = Astro.currentLocale as Locale
const dir = getLocaleDir(currentLocale)
const m = useTranslations(currentLocale)

const localeFonts = {
	default: {
		cssVariable: '--font-noto-serif',
		preload: true,
	},
	'en-US': {
		cssVariable: '--font-noto-serif',
		preload: false,
	},
	'zh-CN': {
		cssVariable: '--font-noto-serif-sc',
		preload: false,
	},
	'ru-RU': {
		cssVariable: '--font-noto-serif',
		preload: false,
	},
	'he-IL': {
		cssVariable: '--font-noto-serif-hebrew',
		preload: false,
	},
} as const
const localeFont = localeFonts[currentLocale as keyof typeof localeFonts] ?? localeFonts.default

const sm = defaultTheme.breakpoints.sm
const md = defaultTheme.breakpoints.md
const lg = defaultTheme.breakpoints.lg
const xl = defaultTheme.breakpoints.xl
const xxl = defaultTheme.breakpoints['2xl']
const breakpoints = { sm, md, lg, xl, '2xl': xxl }
const tideMeta: TideMeta = { breakpoints }
---

<!doctype html>
<html lang={currentLocale} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={m.site_favicon()} />
		{Array.isArray(SITE.relMe) ? SITE.relMe.map((rel) => <link rel="me" href={rel} />) : null}
		{SITE.relAuthEndpoint && <link rel="authorization_endpoint" href={SITE.relAuthEndpoint} />}
		{SITE.relWebmention && <link rel="webmention" href={SITE.relWebmention} />}
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable={localeFonts.default.cssVariable} preload={localeFonts.default.preload} />
		<Font
			cssVariable={localeFont.cssVariable}
			preload={Array.isArray(localeFont.preload) ? [...localeFont.preload] : false}
		/>
		<ThemeProvider />
		<slot name="seo" />
		<meta name="tide-meta" content={JSON.stringify(tideMeta)} />
		<script>
			import type { Locale } from '@paraglide/runtime'
			import { m } from '@paraglide/messages.js'
			import { setLocale } from '@paraglide/runtime'

			window.tideMeta = JSON.parse(document.querySelector('meta[name="tide-meta"]')?.getAttribute('content') || '{}')
			window.m = m
			window.setLocale = setLocale
			window.setLocale(document.documentElement.lang as Locale)

			const bar = document.getElementById('page-progress-bar')!

			document.addEventListener('astro:before-preparation', () => {
				bar.classList.remove('progress-bar-complete')
				bar.classList.add('progress-bar-loading')
			})

			document.addEventListener('astro:page-load', () => {
				bar.classList.remove('progress-bar-loading')
				bar.classList.add('progress-bar-complete')
			})
		</script>
	</head>
	<body class="min-h-screen bg-bg text-text flex flex-col">
		<ClientRouter />
		<div id="page-progress-bar" transition:persist></div>
		<ThemeIcons />
		<TideDialogImageViewer />
		<SkipNavLink />
		<Header />
		<slot />
		<Footer />
		<BackToTop />
	</body>
</html>
