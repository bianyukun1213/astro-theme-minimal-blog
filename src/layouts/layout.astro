---
import SkipNavLink from '@components/a11y/skip-nav-link.astro'
import Footer from '@components/footer.astro'
import Header from '@components/header.astro'
import ThemeIcons from '@components/theme-icons.astro'
import ThemeProvider from '@components/theme-provider.astro'
import { SITE } from '@constants'
import '@styles/global.css'
import { removeTrailingSlash } from '@utils'
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang={SITE.lang} dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${removeTrailingSlash(base)}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-plex-sans" preload />
		<ThemeProvider />
		<slot name="seo" />
	</head>
	<body class="min-h-screen bg-bg text-text">
		<ClientRouter />
		<ThemeIcons />
		<SkipNavLink />
		<Header />
		<slot />
		<Footer />
	</body>
</html>
